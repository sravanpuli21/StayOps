{
  "expo": {
    "name": "HOS Management",
    "slug": "hostest",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hos",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hos.management"
    },
    "android": {
      "package": "com.hos.management",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c9ad5656-da09-4680-9bf4-51ac32a6766f"
      }
    },
    "owner": "hosstayops"
  }
}
